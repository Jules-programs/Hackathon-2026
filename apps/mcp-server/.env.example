# Required for Prisma persistence mode. If omitted, the MCP server runs with in-memory storage.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novae_rog?schema=public"

# Optional API key enforcement for all non-health routes.
# Comma-separated list of keys accepted via the x-api-key header.
MCP_API_KEYS="dev-local-key"

# Optional rate limiter tuning.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Optional vault simulation values.
VAULT_TOTAL_BALANCE_USD=42800000
VAULT_RESERVED_COVERAGE_USD=11400000
